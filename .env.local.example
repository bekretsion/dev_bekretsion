# --- ElevenLabs (public agent, safe to expose client-side) ---
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# --- Shared secret the ElevenLabs server tools must send back as the
#     x-tool-secret header. Generate any random string. ---
AGENT_TOOL_SECRET=

# --- Google Calendar (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# Obtained once by visiting /api/google/oauth/start locally and following the flow.
GOOGLE_REFRESH_TOKEN=
# Usually "primary" unless booking onto a specific secondary calendar.
GOOGLE_CALENDAR_ID=primary

# --- Email (Resend) ---
RESEND_API_KEY=
# Must be a verified sender on your Resend account. Use onboarding@resend.dev for local testing.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Your own address — gets a copy of every booking notification.
NOTIFY_EMAIL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
